{
  "name": "ogilvie-family-recipes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"*.{mjs,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:jsonld": "node scripts/jsonld-audit.mjs",
    "test:perf": "node scripts/perf-budget.mjs",
    "test:e2e": "node scripts/smoke-browser.mjs",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@tailwindcss/postcss": "^4.2.4",
    "astro": "~6.1.8",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@axe-core/playwright": "^4.12.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "prettier": "^3",
    "prettier-plugin-astro": "^0.14",
    "typescript": "^5",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
