# Dependencies
node_modules/

# Build output (set once a generator is chosen, e.g. Astro `dist/`, Hugo `public/`)
dist/
public/
.astro/

# Env & secrets
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Private recipe-import inbox — source card photos are never committed (public repo).
/inbox/*
!/inbox/README.md

# External / vendored Claude skills stay local to each clone — NOT committed (user
# preference: keep external skills out of the repo). Our own .claude/agents/ ARE committed.
.claude/skills/

# grill-me-codex planning scratch (process artifacts, not project docs)
PLAN.md
PLAN-REVIEW-LOG.md

# transient agent verification scratch (never commit)
/cook-mode-verify.mjs
/cook-mode-debug.mjs

# session git worktrees (EnterWorktree scratch) — never commit
.claude/worktrees/
