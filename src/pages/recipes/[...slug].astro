---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { groupIngredients, normalizeSteps } from '../../lib/recipe';
import { courseLabel } from '../../lib/taxonomy';
import { formatQty, formatDuration } from '../../lib/format';
import { recipeJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';
import { abs } from '../../lib/site';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { data } = recipe;
const { Content } = await render(recipe);
const hasStory = (recipe.body ?? '').trim().length > 0;
const groups = groupIngredients(data.ingredients);
const steps = normalizeSteps(data.instructions);
const times = (
  [
    ['Prep', data.prepTime],
    ['Cook', data.cookTime],
    ['Total', data.totalTime],
  ] as const
)
  .map(([k, v]) => [k, formatDuration(v)] as const)
  .filter(([, v]) => v);

// Weight toggle is offered only when ≥60% of *measurable* ingredients have grams.
const measurable = data.ingredients.filter((i) => i.qty != null || i.grams != null);
const withGrams = measurable.filter((i) => i.grams != null);
const weightEligible = measurable.length > 0 && withGrams.length / measurable.length >= 0.6;

const baseAmount = (i: (typeof data.ingredients)[number]) => {
  const q = formatQty(i.qty);
  if (!q) return '';
  return i.unit ? `${q} ${i.unit}` : q;
};

let imageUrl: string | undefined;
if (data.image) {
  const img = await getImage({ src: data.image.src, width: 1200 });
  imageUrl = abs(img.src);
}
const jsonLd = [
  recipeJsonLd(recipe, imageUrl),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Recipes', path: '/recipes/' },
    { name: data.title, path: `/recipes/${recipe.id}/` },
  ]),
];

let stepN = 0;
---

<Base title={data.title} description={data.description} jsonLd={jsonLd}>
  <article class="recipe wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/recipes/">Recipes</a>
      <span aria-hidden="true">›</span>
      {data.title}
    </nav>

    <header class="head">
      <p class="eyebrow">{courseLabel(data.course)}</p>
      <h1>{data.title}</h1>
      <div class="meta">
        <span class="by">{data.contributor}</span>
        {
          times.map(([k, v]) => (
            <span>
              <b>{k}</b> {v}
            </span>
          ))
        }
        <span
          ><b>Serves</b>
          <span id="serves-count">{data.servings}</span>{
            data.yield ? ` · ${data.yield}` : ''
          }</span
        >
      </div>
      <p class="lede">{data.description}</p>
    </header>

    {/* Interactive controls — hidden until JS reveals them (no-JS shows base amounts). */}
    <div
      id="controls"
      class="controls"
      data-base-servings={data.servings}
      data-slug={recipe.id}
      data-weight-eligible={weightEligible ? '1' : ''}
      hidden
    >
      <div class="ctl scaler" role="group" aria-label="Scale recipe">
        <label class="ctl-k" for="servings-input">Makes</label>
        <input
          id="servings-input"
          class="servings-input"
          type="number"
          min="1"
          step="1"
          value={data.servings}
        />
        <span class="ctl-k">servings</span>
        <div class="presets" role="radiogroup" aria-label="Quick scale">
          <button type="button" class="seg" data-scale="1" role="radio" aria-checked="true"
            >1×</button
          >
          <button type="button" class="seg" data-scale="2" role="radio" aria-checked="false"
            >2×</button
          >
          <button type="button" class="seg" data-scale="3" role="radio" aria-checked="false"
            >3×</button
          >
        </div>
      </div>
      <div class="ctl units">
        <button
          id="u-system"
          type="button"
          class="toggle"
          data-state="us"
          aria-label="Switch to metric units">US</button
        >
        {
          weightEligible && (
            <button
              id="u-measure"
              type="button"
              class="toggle"
              data-state="volume"
              aria-label="Switch to weight"
            >
              Volume
            </button>
          )
        }
      </div>
      <div class="ctl">
        <button id="cookmode-btn" type="button" class="toggle" aria-pressed="false"
          >Cook mode</button
        >
        <span id="cookmode-status" class="cm-status" role="status" hidden>screen stays on</span
        >
      </div>
      <details class="print-menu ctl">
        <summary class="toggle">Print</summary>
        <div class="print-opts">
          <button type="button" data-print="clean">Clean</button>
          <button type="button" data-print="full">With photo</button>
          <button type="button" data-print="card">4×6 card</button>
        </div>
      </details>
    </div>

    {
      data.image && (
        <figure class="shell">
          <Picture
            src={data.image.src}
            formats={['avif', 'webp']}
            widths={[480, 960, 1440]}
            sizes="(max-width: 60rem) 100vw, 56rem"
            alt={data.image.alt}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="cols">
      <aside class="ing">
        <div class="ing-inner">
          <h2>Ingredients</h2>
          {
            groups.map((g) => (
              <div class="grp">
                {g.section && <h3>{g.section}</h3>}
                <ul>
                  {g.items.map((i) => (
                    <li class="ing-item">
                      <label>
                        <input type="checkbox" class="check" />
                        <span class="ing-text">
                          {baseAmount(i) && (
                            <span
                              class="amount"
                              data-qty={i.qty != null ? String(i.qty) : ''}
                              data-unit={i.unit ?? ''}
                              data-grams={i.grams != null ? String(i.grams) : ''}
                              data-grams-approx={i.gramsApprox ? '1' : ''}
                              data-count={i.qty != null && !i.unit ? '1' : ''}
                            >
                              {baseAmount(i)}
                            </span>
                          )}{' '}
                          {i.item}
                          {i.prep && <em>, {i.prep}</em>}
                          {i.note && <em> ({i.note})</em>}
                        </span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </aside>

      <section class="method">
        <h2>Method</h2>
        <ol class="steps">
          {
            steps.map((s) => {
              stepN += 1;
              return (
                <li style={`--n: '${stepN}'`}>
                  <label>
                    <input type="checkbox" class="check" />
                    <span class="step-body">
                      <p>{s.text}</p>
                      {s.timer && <span class="timer">{formatDuration(s.timer)}</span>}
                    </span>
                  </label>
                </li>
              );
            })
          }
        </ol>

        {
          data.notes && data.notes.length > 0 && (
            <div class="notes">
              <h3>From the family</h3>
              <ul>
                {data.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          hasStory && (
            <details class="story">
              <summary>Read the story</summary>
              <div class="prose">
                <Content />
              </div>
            </details>
          )
        }
      </section>
    </div>
  </article>
</Base>

<script>
  import '../../scripts/recipe';
</script>

<style>
  .recipe {
    padding-block: 1.75rem 1rem;
  }
  .crumbs {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .crumbs a {
    color: var(--muted);
  }
  .head h1 {
    font-size: var(--text-h1);
    margin: 0.9rem 0 1rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .meta b {
    color: var(--text);
    font-weight: 700;
  }
  .meta .by {
    color: var(--accent-ink);
    font-weight: 700;
  }
  .lede {
    font-size: var(--text-lede);
    line-height: 1.5;
    max-width: 46ch;
    margin: 0 0 1.75rem;
  }

  /* Controls bar */
  .controls[hidden] {
    display: none;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.85rem 1.1rem;
    margin: 0 0 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .ctl {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ctl-k {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .servings-input {
    width: 3.5rem;
    font: inherit;
    text-align: center;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--bg);
    color: var(--text);
  }
  .presets {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    overflow: hidden;
  }
  .seg {
    min-height: 40px;
    padding: 0 0.8rem;
    border: 0;
    background: var(--surface);
    color: var(--text);
    font: 600 0.9rem var(--font-display);
    cursor: pointer;
  }
  .seg + .seg {
    border-left: 1px solid var(--line);
  }
  .seg.active {
    background: var(--accent);
    color: var(--on-accent);
  }
  .toggle {
    min-height: 40px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    background: var(--surface);
    color: var(--text);
    font: 600 0.9rem var(--font-display);
    cursor: pointer;
  }
  .toggle[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .cm-status {
    font-size: 0.78rem;
    color: var(--accent-ink);
  }
  .print-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .print-menu > summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
  }
  .print-menu > summary::-webkit-details-marker {
    display: none;
  }
  .print-opts {
    position: absolute;
    z-index: 20;
    margin-top: 0.4rem;
    display: flex;
    flex-direction: column;
    min-width: 9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .print-opts button {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .print-opts button:hover {
    background: var(--sunken);
  }

  .shell {
    margin: 0 0 3rem;
    background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 0.4rem;
  }
  .shell :global(picture),
  .shell :global(img) {
    display: block;
    width: 100%;
  }
  .shell :global(img) {
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .cols {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 52rem) {
    .cols {
      grid-template-columns: 19rem 1fr;
    }
    .ing {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }
  h2 {
    font-size: var(--text-h2);
    margin: 0 0 1.25rem;
  }
  .ing-inner {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
    box-shadow: var(--shadow-card);
  }
  .grp h3 {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-ink);
    margin: 1.25rem 0 0.5rem;
  }
  .ing ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ing-item label {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .check {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
    transform: translateY(0.15rem);
  }
  .amount {
    font-weight: 700;
    color: var(--accent-ink);
    white-space: nowrap;
  }
  .ing-text em {
    color: var(--muted);
    font-style: normal;
  }
  label:has(.check:checked) .ing-text {
    text-decoration: line-through;
    color: var(--muted);
  }
  label:has(.check:checked) .amount {
    color: var(--muted);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .steps li::before {
    content: var(--n);
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font: 800 0.95rem var(--font-display);
    border-radius: var(--radius-sm);
  }
  .steps label {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    cursor: pointer;
  }
  .step-body {
    display: block;
  }
  .step-body p {
    margin: 0.2rem 0 0;
    font-size: 1.06rem;
    max-width: 60ch;
  }
  label:has(.check:checked) .step-body {
    text-decoration: line-through;
    color: var(--muted);
  }
  .timer {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: var(--accent-ink);
    font-weight: 700;
  }

  .notes {
    margin-top: 2rem;
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
  }
  .notes h3 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }
  .notes ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .notes li {
    margin-bottom: 0.4rem;
  }
  .story {
    margin-top: 1.75rem;
  }
  .story summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.5rem 0;
  }
  .prose {
    max-width: 60ch;
  }

  /* Cook mode: enlarge steps, dim chrome (no step navigator). */
  :global(body.cook-mode) .crumbs,
  :global(body.cook-mode) .head .meta,
  :global(body.cook-mode) .lede,
  :global(body.cook-mode) .story,
  :global(body.cook-mode) :is(.site-header, .site-footer) {
    opacity: 0.4;
  }
  :global(body.cook-mode) .step-body p {
    font-size: 1.35rem;
    line-height: 1.5;
  }
  :global(body.cook-mode) .steps li {
    margin-bottom: 2.25rem;
  }
</style>
