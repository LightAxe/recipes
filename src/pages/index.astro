---
import Base from '../layouts/Base.astro';
import CardGrid from '../components/CardGrid.astro';
import { websiteJsonLd, itemListJsonLd } from '../lib/jsonld';
import { allRecipes, taxonomyIndex, byNewest } from '../lib/browse';
import { COURSE_SLUGS, courseLabel } from '../lib/taxonomy';

const recipes = (await allRecipes()).sort(byNewest);
const latest = recipes.slice(0, 6);
const index = await taxonomyIndex();
const courses = COURSE_SLUGS.filter((slug) => index.category.has(slug)).map((slug) => ({
  slug,
  label: courseLabel(slug),
  count: index.category.get(slug)!.items.length,
}));

const jsonLd = [websiteJsonLd(), itemListJsonLd(latest)];
---

<Base
  title="Ogilvie Family Recipes"
  description="A home for our family's recipes — to cook from, print, and pass down."
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <p class="eyebrow">The family cookbook</p>
    <h1>Ogilvie Family Recipes</h1>
    <p class="lede">
      Our family's recipes, gathered in one place — to cook from, print, and pass down.
    </p>
    <form
      class="hero-search"
      role="search"
      aria-label="Recipe search"
      action="/search/"
      method="get"
    >
      <label class="vh" for="hero-search-input">Search recipes</label>
      <input
        type="search"
        id="hero-search-input"
        name="q"
        placeholder={`Search ${recipes.length} recipes…`}
        autocomplete="off"
      />
      <button type="submit">Search</button>
    </form>
  </section>

  <section class="wrap">
    <div class="head">
      <h2>Browse by category</h2>
    </div>
    <ul class="tiles" role="list">
      {
        courses.map((c) => (
          <li>
            <a href={`/category/${c.slug}/`}>
              <span class="tile-label">{c.label}</span>
              <span class="tile-count">
                {c.count} recipe{c.count === 1 ? '' : 's'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap">
    <div class="head">
      <h2>Latest additions</h2>
      <a class="all" href="/recipes/">All recipes <span aria-hidden="true">→</span></a>
    </div>
    <CardGrid recipes={latest} />
  </section>

  <section class="wrap">
    <a class="tips-teaser" href="/tips/">
      <span class="tt-kicker">Kitchen reference</span>
      <span class="tt-title">Tips &amp; Conversions</span>
      <span class="tt-desc"
        >Cups to grams, oven temperatures, techniques, and family know-how <span
          aria-hidden="true">→</span
        ></span
      >
    </a>
  </section>
</Base>

<style>
  .hero {
    padding-block: 3rem 1.5rem;
  }
  .hero h1 {
    font-size: var(--text-h1);
    margin: 1rem 0 0.75rem;
  }
  .hero .lede {
    font-size: var(--text-lede);
    color: var(--muted);
    max-width: 44ch;
    margin: 0 0 1.75rem;
  }
  .hero-search {
    display: flex;
    gap: 0.6rem;
    max-width: 34rem;
  }
  .hero-search input {
    flex: 1;
    /* Inputs have an intrinsic min-width (~20ch) that ignores flex-shrink; allow it to shrink so
       the search row fits very narrow phones (≤320px) instead of overflowing the page. */
    min-width: 0;
    min-height: 48px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .hero-search input:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 1px;
  }
  .hero-search button {
    min-height: 48px;
    padding-inline: 1.2rem;
    border: 1px solid var(--accent-ink);
    border-radius: var(--radius);
    background: var(--accent-ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 1.25rem;
  }
  .head h2 {
    margin: 0;
    font-size: 1.6rem;
  }
  .all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .tiles {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 38rem) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 58rem) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .tiles a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    /* Let the grid tracks shrink below the tiles' content width on very narrow phones so the
       2-column grid doesn't overflow the page (≤320px). */
    min-width: 0;
    min-height: 88px;
    justify-content: center;
    padding: 1.1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .tiles a:hover,
  .tiles a:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent-ink);
  }
  .tile-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    /* Break a long label rather than force the tile (and the grid) wider than the viewport. */
    overflow-wrap: anywhere;
  }
  .tile-count {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .tips-teaser {
    display: block;
    margin-top: 2.5rem;
    padding: 1.4rem 1.6rem;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent-ink) 22%, var(--line));
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .tips-teaser:hover,
  .tips-teaser:focus-visible {
    transform: translateY(-3px);
  }
  .tt-kicker {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-eyebrow);
    color: var(--accent-ink);
  }
  .tt-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0.2rem 0 0.3rem;
  }
  .tt-desc {
    display: block;
    color: var(--muted);
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
