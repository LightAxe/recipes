---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardGrid from '../components/CardGrid.astro';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => (b.data.datePublished?.getTime() ?? 0) - (a.data.datePublished?.getTime() ?? 0),
);
const latest = recipes.slice(0, 6);
---

<Base
  title="Ogilvie Family Recipes"
  description="A home for our family's recipes — to cook from, print, and pass down."
>
  <section class="wrap hero">
    <h1>Ogilvie Family Recipes</h1>
    <p class="lead">
      Our family's recipes, gathered in one place — to cook from, print, and pass down.
    </p>
  </section>

  <section class="wrap">
    <div class="head">
      <h2>Latest recipes</h2>
      <a class="all" href="/recipes/">All recipes →</a>
    </div>
    <CardGrid recipes={latest} />
  </section>
</Base>

<style>
  .hero {
    padding-block: 2.5rem 1rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    margin: 0 0 0.5rem;
  }
  .lead {
    font-size: 1.18rem;
    color: var(--text-muted);
    max-width: 42rem;
    margin: 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 1rem;
  }
  .head h2 {
    margin: 0;
    font-size: 1.8rem;
  }
  .all {
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }
</style>
