---
import Base from '../../layouts/Base.astro';
import { taxonomyIndex } from '../../lib/browse';
import { COURSE_SLUGS, courseLabel } from '../../lib/taxonomy';

// Browse fallback for the no-JS path (and for an empty query): the non-empty courses.
const index = await taxonomyIndex();
const courses = COURSE_SLUGS.filter((slug) => index.category.has(slug));
---

<Base title="Search" description="Search the Ogilvie family recipe collection." noindex={true}>
  <section class="wrap">
    <h1>Search</h1>
    <form
      class="page-search"
      role="search"
      aria-label="Recipe search"
      action="/search/"
      method="get"
    >
      <label class="vh" for="search-page-input">Search recipes</label>
      <input
        type="search"
        id="search-page-input"
        name="q"
        placeholder="Search recipes…"
        autocomplete="off"
        aria-controls="search-page-results"
      />
      <button type="submit">Search</button>
    </form>

    {
      /* Course filter plane (#13) — server-rendered (gives the client slug→label for free),
        hidden until a query with matches is active. JS shows/updates counts + wires it. */
    }
    <fieldset id="course-filter" class="course-filter" hidden>
      <legend>Filter by category</legend>
      <ul role="list" class="cf-list">
        {
          courses.map((slug) => (
            <li>
              {/* Count lives inside the label (not aria-hidden) so a checkbox's accessible name
                  is e.g. "Main Dishes (12)" — the per-category count is available to SR users. */}
              <label class="cf-opt">
                <input type="checkbox" name="course" value={slug} />
                <span>{courseLabel(slug)}</span>
                <span class="cf-count" />
              </label>
            </li>
          ))
        }
      </ul>
      <button type="button" class="cf-clear" data-clear hidden>Clear filters</button>
    </fieldset>

    <div id="search-page-results"></div>
    <p id="search-page-status" class="vh" role="status"></p>

    <div class="fallback" id="search-fallback">
      <p>Looking for something specific? Search above, or browse by category:</p>
      <ul class="cat-links" role="list">
        {
          courses.map((slug) => (
            <li>
              <a href={`/category/${slug}/`}>{courseLabel(slug)}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  section {
    padding-block: 1.75rem 1rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 1.25rem;
  }
  .page-search {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    max-width: 36rem;
  }
  .page-search input {
    flex: 1;
    /* Inputs keep an intrinsic ~20ch min-width that ignores flex-shrink; allow shrinking so the
       search row fits narrow phones (≤360px) instead of overflowing the page. */
    min-width: 0;
    min-height: 48px;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .page-search button {
    min-height: 48px;
    padding-inline: 1.1rem;
    border: 1px solid var(--accent-ink);
    border-radius: var(--radius);
    background: var(--accent-ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }
  .course-filter {
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .course-filter legend {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-eyebrow);
    color: var(--muted);
    padding-inline: 0.25rem;
  }
  .cf-list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .cf-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  /* Self-sufficient row hiding: [hidden] must win over the inline-flex above without relying on the
     global normalize reset's [hidden] rule. */
  .cf-list li[hidden] {
    display: none;
  }
  .cf-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    cursor: pointer;
  }
  .cf-opt input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent-ink);
  }
  .cf-count {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .cf-clear {
    margin-top: 0.6rem;
    min-height: 44px;
    padding-inline: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }
  .cf-clear:hover,
  .cf-clear:focus-visible {
    border-color: var(--accent-ink);
  }
  .fallback {
    margin-top: 2rem;
    color: var(--muted);
  }
  .cat-links {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cat-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .cat-links a:hover,
  .cat-links a:focus-visible {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
