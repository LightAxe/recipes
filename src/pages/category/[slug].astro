---
import TaxonomyList from '../../components/TaxonomyList.astro';
import { taxonomyPaths } from '../../lib/browse';

export async function getStaticPaths() {
  return taxonomyPaths('category');
}
const { axis, label, recipes } = Astro.props;
---

<TaxonomyList axis={axis} label={label} recipes={recipes} />
