---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap notfound">
    <div class="petal-divider" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <h1>This page isn't in the recipe box</h1>
    <p>The page you're looking for doesn't exist (or hasn't been added yet).</p>
    <p><a href="/recipes/">Browse all recipes →</a></p>
  </section>
</Base>

<style>
  .notfound {
    padding-block: 3rem 4rem;
    text-align: center;
  }
  .notfound h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin: 0 0 0.75rem;
  }
  .notfound p {
    font-size: 1.1rem;
  }
</style>
