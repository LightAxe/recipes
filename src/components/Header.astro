---
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { taxonomyIndex } from '../lib/browse';
import { COURSE_SLUGS, courseLabel } from '../lib/taxonomy';

const path = Astro.url.pathname;
const onRecipes = path.startsWith('/recipes');
const recipesCurrent = path === '/recipes/' ? 'page' : onRecipes ? 'true' : undefined;
// 'page' only on the exact route; 'true' on descendants (section indicator) — mirrors Recipes.
const tipsCurrent =
  path === '/tips/' ? 'page' : path.startsWith('/tips/') ? 'true' : undefined;
const isCurrent = (p: string) => (path === p ? 'page' : undefined);

// Only courses that actually have recipes appear (docs/taxonomy.md §1), in nav order.
const index = await taxonomyIndex();
const courses = COURSE_SLUGS.filter((slug) => index.category.has(slug)).map((slug) => ({
  slug,
  label: courseLabel(slug),
  count: index.category.get(slug)!.items.length,
}));
---

<header class="site-header">
  <div class="wrap bar">
    <Wordmark />

    {/* Desktop inline nav (hidden on mobile — the hamburger takes over there). */}
    <nav aria-label="Primary" class="primary">
      <a href="/recipes/" aria-current={recipesCurrent}>Recipes</a>
      <details class="cats" id="cats-menu">
        <summary>Categories <span class="caret" aria-hidden="true">▾</span></summary>
        <ul class="cats-list" role="list">
          {
            courses.map((c) => (
              <li>
                <a href={`/category/${c.slug}/`}>
                  {c.label} <span class="n">{c.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href="/tips/" aria-current={tipsCurrent}>Tips</a>
      <a href="/about/" aria-current={isCurrent('/about/')}>About</a>
    </nav>

    <form class="search" role="search" action="/search/" method="get">
      <label class="vh" for="site-search">Search recipes</label>
      <input
        type="search"
        id="site-search"
        name="q"
        placeholder="Search recipes…"
        autocomplete="off"
        aria-controls="site-search-results"
      />
      <div class="search-results" id="site-search-results" hidden></div>
      <p id="site-search-status" class="vh" role="status"></p>
    </form>

    <ThemeToggle />

    {
      /* Mobile hamburger (hidden on desktop). Native <details> → works with no JS; categories
        are flattened inline here to avoid a nested <details>. */
    }
    <details class="menu" id="mobile-menu">
      <summary class="ham"><span aria-hidden="true">☰</span> Menu</summary>
      <nav class="sheet" aria-label="Primary">
        <a href="/recipes/" aria-current={recipesCurrent}>Recipes</a>
        <a href="/tips/" aria-current={tipsCurrent}>Tips</a>
        <a href="/about/" aria-current={isCurrent('/about/')}>About</a>
        <p class="sheet-h" id="sheet-cats-h">Categories</p>
        <ul role="list" aria-labelledby="sheet-cats-h">
          {
            courses.map((c) => (
              <li>
                <a href={`/category/${c.slug}/`}>
                  {c.label} <span class="n">{c.count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script src="../scripts/nav.ts"></script>
<script src="../scripts/search.ts"></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.8rem;
  }
  /* Wordmark takes the left; everything else sits to the right. */
  .bar > :global(.wordmark) {
    margin-right: auto;
  }

  .primary {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .primary > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .primary > a[aria-current] {
    color: var(--accent-ink);
  }

  /* Categories dropdown (native <details> — works with no JS) */
  .cats {
    position: relative;
  }
  .cats > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    padding-inline: 0.25rem;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .cats > summary::-webkit-details-marker {
    display: none;
  }
  .cats > summary .caret {
    display: inline-block;
    font-size: 0.8em;
    color: var(--muted);
  }
  .cats[open] > summary .caret {
    transform: rotate(180deg);
  }
  .cats-list {
    position: absolute;
    right: 0;
    top: 100%;
    margin: 0.4rem 0 0;
    padding: 0.4rem;
    min-width: 16rem;
    max-height: min(70vh, 28rem);
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    list-style: none;
    display: grid;
    gap: 0.1rem;
  }
  .cats-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--text);
    text-decoration: none;
  }
  .cats-list a:hover,
  .cats-list a:focus-visible {
    background: var(--sunken);
    color: var(--accent-ink);
  }
  .cats-list .n {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  /* Search */
  .search {
    position: relative;
  }
  .search input {
    min-height: 44px;
    width: 13rem;
    max-width: 42vw;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .search input:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 1px;
  }
  .search-results {
    position: absolute;
    right: 0;
    top: 100%;
    margin-top: 0.4rem;
    width: min(26rem, 90vw);
    max-height: min(70vh, 30rem);
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 0.4rem;
    z-index: 60;
  }

  /* Mobile hamburger (hidden on desktop) */
  .menu {
    display: none;
    position: relative;
  }
  .menu > summary.ham {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .menu > summary.ham span {
    font-size: 1.25em;
  }
  .menu > summary.ham::-webkit-details-marker {
    display: none;
  }
  .sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    width: min(20rem, 92vw);
    max-height: min(80vh, 34rem);
    overflow-y: auto;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    display: grid;
    gap: 0.1rem;
    z-index: 60;
  }
  .sheet > a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .sheet > a[aria-current],
  .sheet ul a:hover,
  .sheet ul a:focus-visible,
  .sheet > a:hover,
  .sheet > a:focus-visible {
    background: var(--sunken);
    color: var(--accent-ink);
  }
  .sheet-h {
    margin: 0.6rem 0.6rem 0.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--text-eyebrow);
    color: var(--muted);
  }
  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .sheet ul a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--text);
    text-decoration: none;
  }
  .sheet .n {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Mobile: swap the inline nav for the hamburger; search goes full-width in DOM order. */
  @media (max-width: 46rem) {
    .primary {
      display: none;
    }
    .menu {
      display: block;
    }
    .search input {
      width: 100%;
      max-width: none;
    }
    .search {
      flex: 1 1 8rem;
    }
    .search-results {
      width: min(90vw, 26rem);
    }
  }
</style>
