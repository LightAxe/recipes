---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { courseLabel } from '../lib/taxonomy';
import { formatDuration } from '../lib/format';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { data, id } = recipe;
const time = formatDuration(data.totalTime) ?? formatDuration(data.cookTime);
---

<a class="card" href={`/recipes/${id}/`}>
  <div class="thumb">
    {
      data.image ? (
        <Picture
          src={data.image.src}
          formats={['avif', 'webp']}
          widths={[320, 640]}
          sizes="(max-width: 40rem) 100vw, 22rem"
          alt={data.image.alt}
          loading="lazy"
        />
      ) : (
        <span class="ph" aria-hidden="true">
          Ogilvie
        </span>
      )
    }
  </div>
  <div class="body">
    <p class="cat">{courseLabel(data.course)}</p>
    <h3 class="title">{data.title}</h3>
    <p class="meta">
      {time && <span>{time}</span>}
      {
        data.servings ? (
          <span>Serves {data.servings}</span>
        ) : (
          data.yield && <span>{data.yield}</span>
        )
      }
    </p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    box-shadow: var(--shadow-card);
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
  }
  .thumb {
    aspect-ratio: 16 / 10;
    background: var(--sunken);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ph {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--muted);
    opacity: 0.4;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
  }
  .body {
    padding: 1rem 1.15rem 1.2rem;
  }
  .cat {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.66rem;
    color: var(--accent-ink);
    margin: 0 0 0.35rem;
  }
  .title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
