---
// Shared breadcrumb trail, wrapped in an ordered list (WCAG H48 — breadcrumbs are an
// ordered sequence, so they belong in an <ol>). One place fixes the markup for every page.
//
// Items are ordered root → current. The LAST item is the current page: rendered with
// aria-current="page" and never a link. Intermediate items:
//   - with `href`  → a link
//   - without `href` → a non-linking segment (e.g. the taxonomy "Cuisine" axis, which has
//     no index page). breadcrumbJsonLd() drops those URL-less items from the structured data,
//     but they stay visible here for orientation — so the visible <ol> and the JSON-LD
//     BreadcrumbList intentionally differ in length, and are tested separately.
export interface Crumb {
  name: string;
  href?: string;
}
const { items } = Astro.props as { items: Crumb[] };
const lastIndex = items.length - 1;
---

<nav aria-label="Breadcrumb" class="crumbs" data-pagefind-ignore>
  <ol class="crumbs-list" role="list">
    {
      items.map((item, i) => (
        <li class="crumb">
          {i === lastIndex ? (
            <span aria-current="page">{item.name}</span>
          ) : item.href ? (
            <a href={item.href}>{item.name}</a>
          ) : (
            <span class="axis">{item.name}</span>
          )}
          {i !== lastIndex && (
            <span class="sep" aria-hidden="true">
              ›
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .crumbs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .crumb {
    display: inline-flex;
    align-items: center;
  }
  .crumbs a,
  .crumbs .axis,
  .crumbs [aria-current='page'] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .crumbs [aria-current='page'] {
    color: var(--text);
  }
  .sep {
    margin-inline: 0.4rem;
    color: var(--muted);
  }
</style>
