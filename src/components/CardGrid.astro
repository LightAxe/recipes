---
import type { CollectionEntry } from 'astro:content';
import RecipeCard from './RecipeCard.astro';

interface Props {
  recipes: CollectionEntry<'recipes'>[];
  // Forwarded to each card's title; see RecipeCard. Default 3 (home, under an h2 section).
  headingLevel?: 2 | 3;
}
const { recipes, headingLevel = 3 } = Astro.props;
---

<ul class="grid" role="list">
  {
    recipes.map((recipe) => (
      <li>
        <RecipeCard recipe={recipe} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 38rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
