---
import Petal from './Petal.astro';
const year = 2026;
---

<footer class="site-footer">
  <div class="wrap row">
    <p class="copy">© {year} Ogilvie Family</p>
    <p class="universe">
      <Petal class="mark" />
      Part of the <a href="https://axpr.net">axpr</a> cinematic universe
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 3px solid var(--border);
    background: var(--sunken);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1.25rem;
  }
  .copy {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .universe {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .universe .mark {
    color: var(--action);
  }
  .universe a {
    color: var(--action-ink);
    font-weight: 500;
  }
</style>
