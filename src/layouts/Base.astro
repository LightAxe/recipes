---
import '@fontsource-variable/archivo';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_LIVE, CF_ANALYTICS_TOKEN, abs } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** schema.org JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Force noindex on a live build (e.g. single-recipe taxonomy pages). */
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = abs(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Pre-paint: apply an explicit saved theme before first paint (no flash). */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light')
            document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {
      /* Staged until launch: noindex unless SITE_LIVE=true (see lib/site.ts). Also
        noindex per-page (e.g. single-recipe taxonomy pages — thin content). */
    }
    {(!SITE_LIVE || noindex) && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={abs('/rss.xml')}
    />
    {
      jsonLd.map((obj) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(obj).replace(/</g, '\\u003c')}
        />
      ))
    }
    {/* Cloudflare Web Analytics — live build only (cookieless; token is public). */}
    {
      SITE_LIVE && CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
    <slot name="head" />
    {/* 4×6 card page size — enabled (media→print) by the Print menu only for card mode. */}
    <style is:inline id="print-page-card" media="not all">
      @page {
        size: 4in 6in;
        margin: 0.3in;
      }
    </style>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
